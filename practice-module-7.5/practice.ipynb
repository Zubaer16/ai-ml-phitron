   "metadata": {},
   "outputs": [],
   "source": [
    "def create_file(filename, content):\n",
    "    with open(filename,'w') as f:\n",
    "        f.write(content)\n",
    "create_file(\"notes.txt\", \"Hello, this is my first file.\")\n",
    "\n"
   ]
